QLineEdit
{
    border: 1px solid rgb(0, 120, 200);
	border-radius: 4px;     
	background-color: rgb(255, 255, 255);
	color: rgb(25, 189, 181);	
	font-family:SimHei;	
	font-size:14px;	
}

QPushButton
{
    background:qlineargradient(spread:pad,x1:1,y1:0,x2:1,y2:1,stop:0 rgb(255,255,255) stop:1 rgb(200,200,200));  
	border-radius: 4px;   
	min-height:20px;
	font-family:SimHei;	
	font-size:14px;	
}

QPushButton::pressed
{
    background:qlineargradient(spread:pad,x1:1,y1:0,x2:1,y2:1,stop:0 rgb(200,200,200) stop:1 rgb(255,255,255));  
	border-radius: 4px;   
	min-height:20px;
	font-family:SimHei;		
	font-size:14px;
}

QLabel
{
    border: none;
	color: rgb(0, 0, 0);
	font-family:SimHei;
	font-size:14px;
}

QWidget
{
    font-family:SimHei;
    font-size:14px;
}

QLabel#label
{
    background:qlineargradient(spread:pad,x1:1,y1:0,x2:1,y2:1,stop:0 rgb(250,250,250) stop:1 rgb(172,187,206));
}

QWidget#widget
{
    background:qlineargradient(spread:pad,x1:1,y1:0,x2:1,y2:1,stop:0 rgb(250,250,250) stop:1 rgb(92,121,158));
}


QPushButton
{
    background:transparent;
    border:none
}


QComboBox {
   border: 1px solid rgb(240, 240, 240);
   border-radius: 3px;
   height: 30;
}

QComboBox QAbstractItemView {
    background: white;
    border: 1px solid #c0c0c0;
    border-radius: 3px;
    outline: none;
}

QComboBox QAbstractItemView::item {
    background: white;
    color: black;
    padding: 4px 8px;
    border: none;
}

QComboBox QAbstractItemView::item:selected {
    background: #0078d4;
    color: white;
}

QComboBox QAbstractItemView::item:hover {
    background: #f0f0f0;
    color: black;
}

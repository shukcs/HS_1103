QComboBox::drop-down {
	subcontrol-origin: padding; /* 箭头位置基于内边距 */
	subcontrol-position: top right; /* 箭头位于右上角 */
	width: 20px; /* 下拉按钮宽度 */
    padding-right:5px;
	border-left: none; /* 左侧边框 */
}

QComboBox::down-arrow {
